# ==========================================
# UNO ULTRA — Environment Configuration
# ==========================================
# Copia questo file in `.env` e adatta i valori.

# --- Runtime ---
NODE_ENV=development
LOG_LEVEL=info

# --- Networking (TCP + UDP) ---
HTTP_PORT=80
HTTPS_PORT=443
WS_PORT=3000
STUN_PORT=3478
TURN_PORT=5349
WEBRTC_UDP_MIN=19302
WEBRTC_UDP_MAX=19312
TURN_RELAY_MIN=49160
TURN_RELAY_MAX=49200

# --- PostgreSQL ---
POSTGRES_USER=uno
POSTGRES_PASSWORD=uno_dev_password
POSTGRES_DB=uno_ultra

# --- Redis ---
REDIS_PASSWORD=

# --- JWT / Auth ---
JWT_SECRET=change_me_min_32_chars_long_secret!!
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=12

# --- TURN/STUN ---
TURN_REALM=uno-ultra.local
TURN_USER=uno
TURN_PASSWORD=uno_turn_password
TURN_EXTERNAL_IP=

# --- Client (Vite) ---
VITE_API_URL=http://localhost/api
VITE_WS_URL=ws://localhost:3000