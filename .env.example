# ==========================================
# UNO ULTRA — Environment Configuration
# ==========================================
# Copia questo file in `.env` e adatta i valori.

# --- Runtime ---
NODE_ENV=development
LOG_LEVEL=info

# --- Networking (HTTP/WS + Optional WebRTC/TURN) ---
HTTP_PORT=80
WS_PORT=3000
STUN_PORT=3478
TURN_PORT=5349
WEBRTC_UDP_MIN=19302
WEBRTC_UDP_MAX=19312
TURN_RELAY_MIN=49160
TURN_RELAY_MAX=49200

# --- PostgreSQL (override in production) ---
POSTGRES_USER=uno
POSTGRES_PASSWORD=uno_dev_password
POSTGRES_DB=uno_ultra

# --- Redis (required in production via docker-compose.prod.yml) ---
REDIS_PASSWORD=

# --- JWT / Auth (set >=32 random chars in production) ---
JWT_SECRET=change_me_min_32_chars_long_secret!!
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=12

# --- TURN/STUN (production uses TURN_AUTH_SECRET ephemeral HMAC credentials) ---
TURN_REALM=uno-ultra.local
TURN_USER=uno
TURN_PASSWORD=uno_turn_password
TURN_AUTH_SECRET=change_me_strong_turn_secret_min_32_chars
TURN_EXTERNAL_IP=

# --- Client (Vite) ---
VITE_API_URL=http://localhost/api
VITE_WS_URL=ws://localhost:3000